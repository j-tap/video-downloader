PORT=3000
APP_NAME=downloadervr9pro
TRAEFIK_DOMAIN=site.com

# ─── Безопасность ───────────────────────────────────────────────
# Сервис публичный, поэтому любой URL считается недоверенным.
# Запросы во внутреннюю сеть (127.0.0.1, 10/8, 172.16/12, 192.168/16,
# 169.254.169.254, *.local, имена контейнеров) блокируются всегда.

# Сколько прокси стоит перед приложением (Traefik = 1).
# Нужно для корректного определения IP в rate limit.
# TRUST_PROXY_HOPS=1

# Разрешённые порты у скачиваемых ссылок
# ALLOWED_PORTS=80,443

# Белый список доменов. Пусто = список поддерживаемых площадок
# (youtube.com, youtu.be, youtube-nocookie.com, instagram.com, instagr.am,
#  facebook.com, fb.com, fb.watch, kino.pub, cdntogo.net, tiktok.com,
#  vk.com, vk.ru, vkvideo.ru, rutube.ru). Поддомены проходят сами:
#  tiktok.com покрывает короткие vm.tiktok.com и vt.tiktok.com.
# Значение `*` снимает ограничение по хостам — небезопасно для публичного сервиса.
# ALLOWED_HOSTS=youtube.com,youtu.be,kino.pub,cdntogo.net,instagram.com,facebook.com

# Кросс-доменные запросы к API. Пусто = только свой origin.
# CORS_ORIGINS=https://downloader.vr9.pro

# ─── API для серверов (/api/v1) ────────────────────────────────
# Второй вход рядом с сайтом: для серверов-клиентов (первый — Todi).
# Запросы с ключом не проходят защиты для людей (кука vd_client, пределы
# по IP) — вместо них пределы на ключ. Договор: docs/video-links.md
# в репозитории childs-games.
#
# Ключи: имя:секрет через запятую. Имя пишется в журнал, секрет — никогда.
# Пусто = API выключен: весь /api/v1 отвечает 401, сайт работает как раньше.
# Секрет — 32 случайных байта в base64url:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# API_KEYS=todi:СЕКРЕТ

# Отозванные ключи в том же виде: получают 403, а не 401, — по журналу
# видно, что стучится старый клиент, а не прохожий.
# API_KEYS_REVOKED=todi-2026:СТАРЫЙ_СЕКРЕТ

# Где лежат база задач и файлы API. В Docker — том, переживает пересоздание
# контейнера (docker-compose.prod.yml).
# API_DATA_DIR=/app/storage/api

# Пределы на ключ (по договору: 2 в работе, 20 в очереди, 60 новых в час)
# API_KEY_MAX_ACTIVE=2
# API_KEY_MAX_QUEUED=20
# API_KEY_JOBS_PER_HOUR=60
# Одновременно у всего API. По умолчанию MAX_CONCURRENT_DOWNLOADS − 1:
# потолок общий с сайтом, и сайту всегда остаётся место.
# API_MAX_ACTIVE=2
# Потолок на все файлы API на томе; не хватает — задачи ждут в очереди
# API_MAX_STORAGE=10G
# Высота по умолчанию, если клиент не прислал maxHeight
# API_MAX_HEIGHT=1080
# Сколько готовый файл ждёт, пока его заберут (не меньше 60 мин),
# и сколько хранятся записи о задачах (не меньше 24 ч)
# API_FILE_TTL_MINUTES=60
# API_RECORD_TTL_HOURS=24

# ─── Лимиты ресурсов ────────────────────────────────────────────
# MAX_CONCURRENT_DOWNLOADS=3      # одновременных загрузок на сервер
# MAX_CONCURRENT_PER_CLIENT=1     # одновременных загрузок с одного IP
# MAX_DOWNLOAD_SIZE=4G            # потолок на один файл
# MAX_TOTAL_STORAGE=20G           # потолок на все временные файлы
# MAX_DURATION_SECONDS=14400      # максимальная длительность видео
# DOWNLOAD_TIMEOUT_MINUTES=30     # жёсткий таймаут загрузки
# FILE_TTL_MINUTES=5              # сколько готовый файл живёт на диске

# Rate limit по IP
# RATE_LIMIT_DOWNLOAD_MAX=5            # стартов загрузки за окно
# RATE_LIMIT_DOWNLOAD_WINDOW_MINUTES=10
# RATE_LIMIT_API_MAX=240               # прочих запросов за окно
# RATE_LIMIT_API_WINDOW_MINUTES=1

# ─── Выходы (прокси) ────────────────────────────────────────────
# Список через запятую, пробуется по порядку; direct — без прокси.
# PROXY — для всех площадок; переменная площадки его перекрывает.
# PROXY=socks5://127.0.0.1:9050

# YouTube не пускает адреса хостингов (проверка на бота), поэтому идёт через
# общий VPN сервера. В docker-compose.prod.yml по умолчанию:
# YT_PROXY=http://vpn-proxy:8888,direct
# Пустое значение отключает прокси для YouTube:
# YT_PROXY=
# INSTAGRAM_PROXY=
# FACEBOOK_PROXY=
# KINOPUB_PROXY=
# TikTok закрыт для части стран — если с адреса сервера он отвечает 403,
# попробуйте общий VPN: TIKTOK_PROXY=http://vpn-proxy:8888,direct
# TIKTOK_PROXY=
# VK_PROXY=
# RUTUBE_PROXY=

# Имя общей сети с VPN (создаёт make network)
# VPN_EGRESS_NETWORK=vpn-egress

# Cookies (Netscape). Для kino.pub обычно нужна активная сессия через cookies.
# Положите файл в data/cookies.txt (или data/cookiesYoutube.txt) — путь подхватится автоматически.
# Явный путь (локально или в Docker):
# COOKIES_FILE=./data/cookies.txt
# COOKIES_FILE=/app/data/cookies.txt
# Для совместимости можно также использовать YT_COOKIES_FILE

# Отдельный файл cookies для kino.pub (приоритетнее, чем COOKIES_FILE)
# KINOPUB_COOKIES_FILE=./data/cookiesKinoPub.txt
# KINOPUB_COOKIES_FILE=/app/data/cookiesKinoPub.txt

# Опционально: взять cookies напрямую из браузера (chrome/firefox/safari)
# COOKIES_FROM_BROWSER=chrome
# Для совместимости можно также использовать YT_COOKIES_FROM_BROWSER
# Отдельно для kino.pub:
# KINOPUB_COOKIES_FROM_BROWSER=chrome

# Instagram cookies (если reel недоступен без логина)
# INSTAGRAM_COOKIES_FILE=./data/cookiesInstagram.txt
# INSTAGRAM_COOKIES_FILE=/app/data/cookiesInstagram.txt
# INSTAGRAM_COOKIES_FROM_BROWSER=chrome

# Facebook cookies (если видео недоступно без логина)
# FACEBOOK_COOKIES_FILE=./data/cookiesFacebook.txt
# FACEBOOK_COOKIES_FILE=/app/data/cookiesFacebook.txt
# FACEBOOK_COOKIES_FROM_BROWSER=chrome

# TikTok, VK, Rutube cookies (для закрытых и возрастных роликов)
# TIKTOK_COOKIES_FILE=./data/cookiesTiktok.txt
# VK_COOKIES_FILE=./data/cookiesVk.txt
# RUTUBE_COOKIES_FILE=./data/cookiesRutube.txt
# TIKTOK_COOKIES_FROM_BROWSER=chrome
# VK_COOKIES_FROM_BROWSER=chrome
# RUTUBE_COOKIES_FROM_BROWSER=chrome


# ─── PO Token для YouTube ───────────────────────────────────────
# YouTube требует PO Token, чтобы отдать серверу качественные дорожки.
# Без него с адреса VPS обычно приходит либо 403, либо одна дорожка 360p.
# docker-compose.prod.yml поднимает провайдер токенов (bgutil) отдельным
# сервисом и подставляет адрес сам — менять переменную нужно, только если
# провайдер живёт где-то ещё. Пусто = провайдер не используется.
# POT_PROVIDER_BASE_URL=http://potprovider:4416

# Альтернатива провайдеру — токен, добытый руками. Годится ненадолго:
# YouTube привязывает токен к конкретному видео.
# См. https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
# YT_PO_TOKEN=web.gvs+TOKEN,web.player=TOKEN

# Опционально: переопределить player_client (по умолчанию — автовыбор yt-dlp,
# затем фолбэки на клиентов, которым PO Token не нужен).
# Отключает встроенную логику повторов по клиентам.
# YT_PLAYER_CLIENT=web_safari,web_embedded

# ─── Качество и совместимость ───────────────────────────────────
# По умолчанию берётся H.264 + AAC: такой mp4 открывается везде,
# включая QuickTime, Safari, телевизоры и видеоредакторы. Цена — потолок
# 1080p на YouTube (в 4K там раздаётся только AV1 со звуком Opus,
# а это уже не совместимый mp4).
# Снять ограничение (максимум качества, но файл может не открыться):
# VIDEO_FORMAT=bv*+ba/b

# Путь к бинарнику yt-dlp (по умолчанию yt-dlp)
# YTDLP_PATH=yt-dlp

# Канал yt-dlp при сборке образа: nightly (по умолчанию) или stable
# YTDLP_CHANNEL=nightly
